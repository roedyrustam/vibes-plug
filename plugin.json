{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "vibes-plug",
  "displayName": "Vibes-Plug",
  "version": "4.4.1",
  "description": "Universal AI plugin with 161 specialized skills for Cursor, Antigravity, Claude, and OpenAI Codex.",
  "logo": "assets/logo.svg",
  "icon": "assets/logo.svg",
  "author": {
    "name": "Roedy Rustam"
  },
  "homepage": "https://github.com/roedyrustam/vibes-plug",
  "repository": "https://github.com/roedyrustam/vibes-plug.git",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "cursor",
    "mcp",
    "skills",
    "fullstack",
    "fintech",
    "zero-to-prod",
    "anti-slop"
  ],
  "extensions": {
    "com.cursor": {
      "rulesDir": ".cursor/rules/",
      "rulesFile": ".cursorrules",
      "mcpConfig": ".cursor/mcp.json"
    },
    "org.vibesplug.platforms": {
      "antigravity": {
        "entry": "AGENTS.md",
        "config": "plugin.json",
        "skillsDir": "skills/",
        "logo": "assets/logo.svg",
        "icon": "assets/logo.svg"
      },
      "claude": {
        "entry": "CLAUDE.md",
        "rulesDir": ".claude/rules/",
        "skillsDir": "skills/"
      },
      "cursor": {
        "entry": ".cursorrules",
        "rulesDir": ".cursor/rules/",
        "mcp": ".cursor/mcp.json",
        "skillsDir": "skills/"
      },
      "codex": {
        "entry": "CODEX.md",
        "rulesDir": ".codex/rules/",
        "skillsDir": "skills/"
      }
    }
  }
}