{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "vibes-plug",
  "displayName": "Vibes-Plug",
  "version": "4.5.0",
  "description": "Universal AI Agent Swarm & MCP plugin with 176 specialized skills and 8 autonomous subagents for Cursor, Antigravity, Claude Code, Windsurf, and OpenAI Codex.",
  "logo": "assets/logo.svg",
  "icon": "assets/logo.svg",
  "author": {
    "name": "Roedy Rustam"
  },
  "homepage": "https://github.com/roedyrustam/vibes-plug",
  "repository": "https://github.com/roedyrustam/vibes-plug.git",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "multi-agent-swarm",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor-rules",
    "antigravity",
    "openai-codex",
    "vibe-coding",
    "agentic-ai",
    "skill-as-a-tool",
    "reverse-engineering",
    "ghidra",
    "binary-analysis",
    "rea",
    "fullstack",
    "fintech",
    "zero-to-prod",
    "anti-slop",
    "windsurf"
  ],
  "extensions": {
    "com.cursor": {
      "rulesDir": ".cursor/rules/",
      "rulesFile": ".cursorrules",
      "mcpConfig": ".cursor/mcp.json"
    },
    "org.vibesplug.platforms": {
      "antigravity": {
        "entry": "AGENTS.md",
        "config": "plugin.json",
        "skillsDir": "skills/",
        "logo": "assets/logo.svg",
        "icon": "assets/logo.svg"
      },
      "claude": {
        "entry": "CLAUDE.md",
        "rulesDir": ".claude/rules/",
        "skillsDir": "skills/"
      },
      "cursor": {
        "entry": ".cursorrules",
        "rulesDir": ".cursor/rules/",
        "mcp": ".cursor/mcp.json",
        "skillsDir": "skills/"
      },
      "codex": {
        "entry": "CODEX.md",
        "rulesDir": ".codex/rules/",
        "skillsDir": "skills/"
      }
    }
  }
}