{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "vibes-plug",
  "displayName": "Vibes-Plug: Autonomous AI Swarm",
  "version": "4.7.2",
  "description": "Universal AI Agent Swarm & MCP plugin with 178 specialized skills, 9 autonomous subagents, and auto-activating Swarm Director for Antigravity, Cursor, Claude Code, Windsurf, and OpenAI Codex.",
  "logo": "assets/logo.svg",
  "icon": "assets/logo.svg",
  "suggestedPrompts": [
    "Activate autonomous multi-agent swarm to design and implement this task",
    "Dispatch fullstack-craftsman and quality-guardian in parallel",
    "Audit codebase invariants, AST symbols, and enforce anti-slop rules"
  ],
  "author": {
    "name": "Roedy Rustam",
    "email": "roedyrustam.id@gmail.com",
    "url": "https://github.com/roedyrustam"
  },
  "publisher": {
    "name": "Roedy Rustam",
    "url": "https://github.com/roedyrustam"
  },
  "homepage": "https://github.com/roedyrustam/vibes-plug",
  "repository": {
    "type": "git",
    "url": "https://github.com/roedyrustam/vibes-plug.git"
  },
  "bugs": {
    "url": "https://github.com/roedyrustam/vibes-plug/issues"
  },
  "documentation": "https://github.com/roedyrustam/vibes-plug#readme",
  "changelog": "https://github.com/roedyrustam/vibes-plug/blob/main/CHANGELOG.md",
  "privacyUrl": "https://github.com/roedyrustam/vibes-plug/blob/main/PRIVACY.md",
  "termsUrl": "https://github.com/roedyrustam/vibes-plug/blob/main/TERMS.md",
  "securityContact": "roedyrustam.id@gmail.com",
  "securityPolicy": "https://github.com/roedyrustam/vibes-plug/blob/main/SECURITY.md",
  "license": "MIT",
  "licenseUrl": "https://github.com/roedyrustam/vibes-plug/blob/main/LICENSE",
  "pricing": "free",
  "keywords": [
    "ai-agents",
    "multi-agent-swarm",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor-rules",
    "antigravity",
    "openai-codex",
    "vibe-coding",
    "agentic-ai",
    "skill-as-a-tool",
    "reverse-engineering",
    "ghidra",
    "binary-analysis",
    "rea",
    "fullstack",
    "fintech",
    "zero-to-prod",
    "anti-slop",
    "windsurf"
  ],
  "extensions": {
    "com.cursor": {
      "rulesDir": ".cursor/rules/",
      "rulesFile": ".cursorrules",
      "mcpConfig": ".cursor/mcp.json"
    },
    "org.vibesplug.platforms": {
      "antigravity": {
        "entry": "AGENTS.md",
        "config": "plugin.json",
        "skillsDir": "skills/",
        "logo": "assets/logo.svg",
        "icon": "assets/logo.svg"
      },
      "claude": {
        "entry": "CLAUDE.md",
        "rulesDir": ".claude/rules/",
        "skillsDir": "skills/"
      },
      "cursor": {
        "entry": ".cursorrules",
        "rulesDir": ".cursor/rules/",
        "mcp": ".cursor/mcp.json",
        "skillsDir": "skills/"
      },
      "codex": {
        "entry": "CODEX.md",
        "rulesDir": ".codex/rules/",
        "skillsDir": "skills/"
      }
    }
  }
}
