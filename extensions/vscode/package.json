{
  "name": "vibes-plug-companion",
  "displayName": "VibesPlug Pro: 161-Skill AI Swarm Companion",
  "description": "Turn VSCode and Cursor into an autonomous 161-agent AI software studio. Zero AI Slop, Sovereign Anti-Slop Directive, Studio Cockpit, and MCP v1.x integration.",
  "version": "4.4.1",
  "icon": "icon.png",
  "publisher": "roedyrustam",
  "author": {
    "name": "Roedy Rustam"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roedyrustam/vibes-plug"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Linters",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "ai",
    "agents",
    "swarm",
    "anti-slop",
    "mcp",
    "cursor",
    "claude",
    "gemini",
    "antigravity"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vibes.openStudio",
        "title": "VibesPlug: Open Studio Cockpit",
        "category": "VibesPlug"
      },
      {
        "command": "vibes.wizard",
        "title": "VibesPlug: Project Scaffolding Wizard",
        "category": "VibesPlug"
      },
      {
        "command": "vibes.runGuard",
        "title": "VibesPlug: Run Sovereign Anti-Slop Guard",
        "category": "VibesPlug"
      },
      {
        "command": "vibes.criticValidate",
        "title": "VibesPlug: Critic Validate Active File",
        "category": "VibesPlug"
      },
      {
        "command": "vibes.finopsStatus",
        "title": "VibesPlug: View Token Savings & FinOps Report",
        "category": "VibesPlug"
      },
      {
        "command": "vibes.sync",
        "title": "VibesPlug: Synchronize Primary Trigger & 161 Skills",
        "category": "VibesPlug"
      },
      {
        "command": "vibes.bridgeSync",
        "title": "VibesPlug: Synchronize Cross-IDE Rules & Bridge",
        "category": "VibesPlug"
      },
      {
        "command": "vibes.learnSkill",
        "title": "VibesPlug: Synthesize Gold-Standard AI Skill",
        "category": "VibesPlug"
      },
      {
        "command": "vibes.verifyGate",
        "title": "VibesPlug: Pre-Disk Verification Gate on Active File",
        "category": "VibesPlug"
      },
      {
        "command": "vibes.swarmDispatch",
        "title": "VibesPlug: Dispatch Concurrent Multi-Agent Swarm",
        "category": "VibesPlug"
      },
      {
        "command": "vibes.graphSearch",
        "title": "VibesPlug: Local Hybrid GraphRAG Search",
        "category": "VibesPlug"
      },
      {
        "command": "vibes.detect",
        "title": "VibesPlug: Detect Project Stack & Recommend Skills",
        "category": "VibesPlug"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vibes.criticValidate",
          "group": "7_modification",
          "when": "editorTextFocus"
        },
        {
          "command": "vibes.verifyGate",
          "group": "7_modification",
          "when": "editorTextFocus"
        }
      ],
      "commandPalette": [
        {
          "command": "vibes.openStudio"
        },
        {
          "command": "vibes.wizard"
        },
        {
          "command": "vibes.runGuard"
        },
        {
          "command": "vibes.criticValidate"
        },
        {
          "command": "vibes.finopsStatus"
        },
        {
          "command": "vibes.sync"
        },
        {
          "command": "vibes.bridgeSync"
        },
        {
          "command": "vibes.learnSkill"
        },
        {
          "command": "vibes.verifyGate"
        },
        {
          "command": "vibes.swarmDispatch"
        },
        {
          "command": "vibes.graphSearch"
        }
      ]
    },
    "configuration": {
      "title": "VibesPlug Pro",
      "properties": {
        "vibes.studioPort": {
          "type": "number",
          "default": 3888,
          "description": "Port number for the local Vibes Studio Cockpit web dashboard."
        },
        "vibes.antiSlopStrictMode": {
          "type": "boolean",
          "default": true,
          "description": "Treat all Anti-Slop warnings as fatal errors in CI and local guard runs."
        },
        "vibes.defaultReasoningProfile": {
          "type": "string",
          "enum": [
            "speed",
            "balanced",
            "deep",
            "exhaustive"
          ],
          "default": "balanced",
          "description": "Default reasoning profile & thinking token budget for Swarm Director tasks."
        }
      }
    }
  }
}
