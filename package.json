{
  "name": "vibes-plug",
  "version": "3.6.0",
  "description": "Universal AI plugin with 124 specialized skills for Antigravity, Claude, and Cursor. Updated for the modern 2026 tech stack (React 19, Tailwind v4, Bun, Hono, AI Safety, CUA). Designed to support software development, UI/UX design, SEO optimization, and SaaS business strategies",
  "main": "index.js",
  "bin": {
    "vibes-plug": "scripts/install.js",
    "vibes": "bin/vibes.mjs"
  },
  "files": [
    "index.js",
    "plugin.json",
    "AGENTS.md",
    "CLAUDE.md",
    ".cursorrules",
    "scripts",
    "skills",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo",
    ".claude",
    ".cursor",
    "README.md",
    "BLUEPRINT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "generate:gif": "python scripts/generate_swarm_gif.py",
    "update-skills": "node scripts/update_skills.mjs",
    "audit": "node scripts/check-anti-slop.mjs",
    "install-all": "node scripts/install.js --all",
    "install-claude": "node scripts/install.js --claude",
    "install-cursor": "node scripts/install.js --cursor"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roedyrustam/vibes-plug.git"
  },
  "keywords": [
    "antigravity",
    "claude-code",
    "cursor-rules",
    "ai-agents",
    "multi-agent-swarm",
    "mcp",
    "model-context-protocol",
    "vibe-coding",
    "react19",
    "nextjs15",
    "tailwindcss-v4",
    "bun",
    "skills",
    "developer-tools",
    "zero-to-prod"
  ],
  "author": "Roedy Rustam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/roedyrustam/vibes-plug/issues"
  },
  "homepage": "https://github.com/roedyrustam/vibes-plug#readme"
}
