{
  "name": "vibes-plug",
  "version": "4.5.0",
  "description": "Universal AI Agent Swarm & MCP plugin with 176 specialized skills and 9 autonomous subagents for Antigravity, Claude Code, Cursor, Windsurf, and OpenAI Codex. Updated for the modern 2026 tech stack (React 19, Tailwind v4, Bun, Hono, A2A, MCP, Universal Skill-as-a-Tool SaaT, Ghidra/REA Reverse Engineering, ClickHouse, Kubernetes GitOps, CUA).",
  "icon": "assets/logo.png",
  "main": "index.js",
  "bin": {
    "vibes-plug": "scripts/install.js",
    "vibes": "bin/vibes.mjs"
  },
  "files": [
    "index.js",
    "bin",
    "assets",
    "agents",
    "templates",
    "mcp_config.json",
    "plugin.json",
    "gemini-extension.json",
    ".codex-plugin",
    "AGENTS.md",
    "CLAUDE.md",
    "CODEX.md",
    "CATALOG.md",
    "CATALOG.json",
    ".cursorrules",
    ".clinerules",
    ".windsurfrules",
    ".traerules",
    ".kimirules",
    ".kirorules",
    ".cache-prefix.json",
    ".skill-slices.json",
    "scripts",
    "skills",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo",
    ".claude",
    ".cursor",
    ".codex",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "install.sh",
    "install.ps1",
    ".well-known"
  ],
  "scripts": {
    "test": "node scripts/audit-graph.mjs && node scripts/validate-skills.mjs && node scripts/verify-skill-snippets.mjs && node scripts/check-anti-slop.js --strict && node --test scripts/test-cli.mjs",
    "test:cli": "node --test scripts/test-cli.mjs",
    "audit:graph": "node scripts/audit-graph.mjs",
    "anti-slop": "node scripts/check-anti-slop.js",
    "anti-slop:strict": "node scripts/check-anti-slop.js --strict",
    "anti-slop:fix": "node scripts/check-anti-slop.js --fix",
    "generate:gif": "python scripts/generate_swarm_gif.py",
    "update-skills": "node scripts/update_skills.mjs",
    "catalog:sync": "node scripts/generate-catalog.mjs",
    "audit": "node scripts/check-anti-slop.mjs",
    "install-all": "node scripts/install.js --all",
    "install-claude": "node scripts/install.js --claude",
    "install-cursor": "node scripts/install.js --cursor",
    "install-codex": "node scripts/install.js --codex",
    "compile-cache": "node scripts/compile-cache.mjs",
    "compile:slices": "node scripts/compile-skill-slices.mjs",
    "verify:snippets": "node scripts/verify-skill-snippets.mjs",
    "db:eval": "node scripts/eval-migration.mjs",
    "ast": "node scripts/ast-query.mjs",
    "arbitrate": "node scripts/speculative-arbiter.mjs",
    "verify:invariants": "node scripts/verify-invariants.mjs",
    "swarm": "node scripts/swarm-runner.mjs",
    "memory": "node scripts/memory-daemon.mjs",
    "mcp": "node bin/mcp-server.mjs",
    "guard": "npm test && node scripts/compile-cache.mjs && node scripts/compile-skill-slices.mjs && node scripts/eval-migration.mjs && node scripts/verify-invariants.mjs && node scripts/swarm-runner.mjs && node scripts/memory-daemon.mjs checkpoint",
    "package:vscode": "node scripts/package-extension.mjs",
    "bench": "node scripts/benchmark-suite.mjs",
    "hooks": "node scripts/git-hook-installer.mjs",
    "budget": "node scripts/token-budget-optimizer.mjs",
    "drift": "node scripts/skill-drift-monitor.mjs",
    "monitor": "node scripts/terminal-monitor.mjs",
    "consensus": "node scripts/speculative-consensus.mjs",
    "supercharge": "node scripts/supercharge-all-skills.mjs",
    "skill:exec": "node scripts/skill-dispatcher.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roedyrustam/vibes-plug.git"
  },
  "keywords": [
    "antigravity",
    "claude-code",
    "cursor-rules",
    "codex",
    "openai-codex",
    "ai-agents",
    "multi-agent-swarm",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "vibe-coding",
    "agentic-ai",
    "claude-skills",
    "cursor",
    "windsurf",
    "trae",
    "swarm-intelligence",
    "multi-agent-systems",
    "a2a-protocol",
    "skill-as-a-tool",
    "reverse-engineering",
    "ghidra",
    "binary-analysis",
    "rea",
    "fullstack",
    "react19",
    "nextjs15",
    "tailwindcss-v4",
    "bun",
    "skills",
    "developer-tools",
    "zero-to-prod"
  ],
  "author": "Roedy Rustam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/roedyrustam/vibes-plug/issues"
  },
  "homepage": "https://github.com/roedyrustam/vibes-plug#readme"
}
