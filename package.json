{
  "name": "vibes-plug",
  "version": "4.3.0",
  "description": "Universal AI plugin with 155 specialized skills for Antigravity, Claude, Cursor, and OpenAI Codex. Updated for the modern 2026 tech stack (React 19, Tailwind v4, Bun, Hono, AI Safety, CUA). Designed to support software development, UI/UX design, SEO optimization, and SaaS business strategies",
  "main": "index.js",
  "bin": {
    "vibes-plug": "scripts/install.js",
    "vibes": "bin/vibes.mjs"
  },
  "files": [
    "index.js",
    "bin",
    "assets",
    "agents",
    "templates",
    "mcp_config.json",
    "plugin.json",
    "gemini-extension.json",
    ".codex-plugin",
    "AGENTS.md",
    "CLAUDE.md",
    "CODEX.md",
    "CATALOG.md",
    "CATALOG.json",
    ".cursorrules",
    ".clinerules",
    ".windsurfrules",
    ".traerules",
    ".kimirules",
    ".kirorules",
    ".cache-prefix.json",
    "scripts",
    "skills",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo",
    ".claude",
    ".cursor",
    ".codex",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/validate-skills.mjs && node scripts/check-anti-slop.js --strict && node --test scripts/test-cli.mjs",
    "test:cli": "node --test scripts/test-cli.mjs",
    "anti-slop": "node scripts/check-anti-slop.js",
    "anti-slop:strict": "node scripts/check-anti-slop.js --strict",
    "anti-slop:fix": "node scripts/check-anti-slop.js --fix",
    "generate:gif": "python scripts/generate_swarm_gif.py",
    "update-skills": "node scripts/update_skills.mjs",
    "audit": "node scripts/check-anti-slop.mjs",
    "install-all": "node scripts/install.js --all",
    "install-claude": "node scripts/install.js --claude",
    "install-cursor": "node scripts/install.js --cursor",
    "install-codex": "node scripts/install.js --codex",
    "compile-cache": "node scripts/compile-cache.mjs",
    "db:eval": "node scripts/eval-migration.mjs",
    "ast": "node scripts/ast-query.mjs",
    "arbitrate": "node scripts/speculative-arbiter.mjs",
    "verify:invariants": "node scripts/verify-invariants.mjs",
    "swarm": "node scripts/swarm-runner.mjs",
    "memory": "node scripts/memory-daemon.mjs",
    "mcp": "node bin/mcp-server.mjs",
    "guard": "npm test && node scripts/compile-cache.mjs && node scripts/eval-migration.mjs && node scripts/verify-invariants.mjs && node scripts/swarm-runner.mjs && node scripts/memory-daemon.mjs checkpoint",
    "package:vscode": "node scripts/package-extension.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roedyrustam/vibes-plug.git"
  },
  "keywords": [
    "antigravity",
    "claude-code",
    "cursor-rules",
    "codex",
    "openai-codex",
    "ai-agents",
    "multi-agent-swarm",
    "mcp",
    "model-context-protocol",
    "vibe-coding",
    "react19",
    "nextjs15",
    "tailwindcss-v4",
    "bun",
    "skills",
    "developer-tools",
    "zero-to-prod"
  ],
  "author": "Roedy Rustam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/roedyrustam/vibes-plug/issues"
  },
  "homepage": "https://github.com/roedyrustam/vibes-plug#readme"
}
