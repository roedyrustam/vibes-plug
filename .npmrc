# npm Security Configuration (Supply Chain Defense & npm v12+ Compliance)
# https://github.blog/changelog/2026-07-08-npm-install-time-security-and-gat-bypass2fa-deprecation/

# Disable arbitrary lifecycle scripts by default
allow-scripts=false

# Restrict untrusted remote HTTP/tarball URLs
allow-remote=false

# Default to signed Sigstore provenance on publish
provenance=true
